<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<CodeBlocks_project_file>
<FileVersion major="1" minor="6" />
<Project>
<Option title="JL380N_PMC" />
<Option compiler="pi32v2_r3_lto_compiler" />
<Build>
<Target title="Release">
<Option output="apps/bsp/cpu/br33/post_build/p11.elf" prefix_auto="0" extension_auto="0" />
<Option object_output="obj/Release/" />
<Option type="1" />
<Option compiler="pi32v2_r3_lto_compiler" />
<Compiler>
<Add option="-Wuninitialized" />
<Add option="-Wno-invalid-noreturn" />
<Add option="-fno-common" />
<Add option="-integrated-as" />
<Add option="-Oz" />
<Add option="-g" />
<Add option="-flto" />
<Add option="-fallow-pointer-null" />
<Add option="-fprefer-gnu-section" />
<Add option="-Wno-shift-negative-value" />
<Add option="-fms-extensions" />
<Add option="-DSUPPORT_MS_EXTENSIONS" />
<Add option="-fdiscrete-bitfield-abi" />
<Add option="-DCONFIG_RELEASE_ENABLE" />
<Add option="-D__GCC_Q32S__" />
<Add option="-DPMU_SYSTEM" />
<Add option="-DCPU_CORE_NUM=1" />
<Add option="-DCONFIG_CPU_BR33" />
<Add option="-DCONFIG_BR33_FPGA_VERIFY" />
<Add option="-DCONFIG_UCOS_ENABLE" />
<Add option="-DBREDR_PMC_CODE" />
<Add option="-DBT_PMC_BT_FUN_OVERWRITE" />
<Add option="-DBREDR_Q32F" />
<Add option="-DCONFIG_NEW_BREDR_ENABLE" />
<Add option="-DCONFIG_NEW_MODEM_ENABLE" />
<Add option="-DCONFIG_SUPPORT_AES_CCM_FOR_EDR" />
<Add option="-DCONFIG_SUPPORT_EX_TWS_ADJUST" />
<Add directory="apps" />
<Add directory="apps/bsp/cpu/br33/config" />
<Add directory="include/driver" />
<Add directory="include/driver/cpu/br33" />
<Add directory="include/driver/cpu/br33/power/pmc" />
<Add directory="include/system" />
<Add directory="include/system/typedef" />
<Add directory="include/system/cpu/br33" />
<Add directory="include/utils" />
<Add directory="include/utils/generic" />
<Add directory="apps/sensor" />
<Add directory="apps/sensor/driver_vc_hr_11" />
<Add directory="apps/btctrler/soft_baseband" />
<Add directory="apps/sensor/driver" />
<Add directory="apps/sensor/driver/driver_vc_hr_11" />
<Add directory="apps/sensor/driver/driver_hr_vc30fx" />
<Add directory="apps/sensor/hal" />
<Add directory="apps/sensor/service" />
</Compiler>
<Linker>
<Add option="--plugin-opt=-pi32v2-always-use-itblock=false" />
<Add option="--plugin-opt=-enable-ipra=true" />
<Add option="--plugin-opt=-pi32v2-merge-max-offset=4096" />
<Add option="--plugin-opt=-pi32v2-enable-simd=true" />
<Add option="--plugin-opt=mcpu=r3" />
<Add option="--plugin-opt=-global-merge-on-const" />
<Add option="--plugin-opt=-inline-threshold=5" />
<Add option="--plugin-opt=-inline-max-allocated-size=32" />
<Add option="--plugin-opt=-inline-normal-into-special-section=true" />
<Add option="--plugin-opt=-dont-used-symbol-list=malloc,free,sprintf,printf,puts,putchar" />
<Add option="--plugin-opt=save-temps" />
<Add option="--plugin-opt=-pi32v2-enable-rep-memop" />
<Add option="--plugin-opt=-warn-stack-size=1024" />
<Add option="--sort-common" />
<Add option="--dont-complain-call-overflow" />
<Add option="--plugin-opt=-floating-point-may-trap=true" />
<Add option="--gc-sections" />
<Add option="--plugin-opt=-pi32v2-csync-before-rti=true" />
<Add option="--start-group" />
<Add option="apps/bsp/cpu/br33/liba/bt/watch/btctrler_pmc.a" />
<Add option="apps/bsp/cpu/br33/liba/system.a" />
<Add option="apps/bsp/cpu/br33/liba/cpu.a" />
<Add option="apps/bsp/cpu/br33/liba/utils.a" />
<Add option="apps/bsp/cpu/br33/liba/jl_motion_v0.a" />
<Add option="--end-group" />
<Add option="-Tapps/bsp/cpu/br33/p11.ld" />
<Add option="-M=apps/bsp/cpu/br33/post_build/p11.map" />
<Add library="C:\JL\pi32\pi32v2-lib\r3\libm.a" />
</Linker>
<ExtraCommands>
<Add before="$compiler $options $includes -D__LD__ -E -P apps\bsp\cpu\br33\p11_used_list.c -o apps\bsp\cpu\br33\p11_used_list.used" />
<Add before="$compiler $options $includes -D__LD__ -E -P apps\bsp\cpu\br33\p11_ld.c -o apps\bsp\cpu\br33\p11.ld" />
<Add before="$compiler $options $includes -D__LD__ -E -P apps\bsp\cpu\br33\post_build\download_wid.c -o apps\bsp\cpu\br33\post_build\download.bat" />
<Add before="tools\utils\fixbat.exe apps\bsp\cpu\br33\post_build\download.bat" />
<Mode before="always" />
<Add after="apps\bsp\cpu\br33\post_build\download.bat p11" />
<Mode after="always" />
</ExtraCommands>
</Target>
</Build>
